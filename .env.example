# =====================================================================
# ZeroQueue - the ONE AND ONLY environment file.
# Copy this file to ".env" (same folder) and fill in real values locally.
# ".env" is in .gitignore: never commit it, never paste keys into chat.
# Everything runs WITHOUT any of these values (MOCK_MODE=true default).
# =====================================================================

# ----- Web (Next.js page) -----
# Where the page finds the backend API:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Intercom app id from the Intercom setup checklist. Leave BLANK to use
# the built-in fallback chat instead of Intercom Messenger:
#able to get here https://app.intercom.com/a/apps/i5i68lou/settings/workspace/general
NEXT_PUBLIC_INTERCOM_APP_ID= 
NEXT_PUBLIC_DEMO_BRAND_NAME=

# ----- General -----
APP_ENV=development
# MOCK_MODE=true means: no paid/external API calls (Intercom + Groq stay fake).
# Local OCR still works in mock mode because it runs on your own machine.
MOCK_MODE=true
DATABASE_URL=sqlite:///./zeroqueue.db
CORS_ORIGINS=http://localhost:3000
# Protects POST /api/demo/reset so strangers cannot wipe the demo state.
DEMO_RESET_SECRET=change-me-to-a-long-random-string

# ----- Web page (read by the Next.js app from THIS same file) -----
# Where the page finds the backend API:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_BRAND_NAME=ZeroQueue

# ----- LLM (Groq free tier; only used when MOCK_MODE=false) -----
# Get a free key at https://console.groq.com -> API Keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Vision model used to read images/invoices when OCR_PROVIDER=groq:
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ----- Attachments / OCR -----
# tesseract = free local OCR (needs the Tesseract installer, see README).
# groq      = sends the image to the free Groq vision model instead.
OCR_PROVIDER=tesseract
# Windows only: if pytesseract cannot find Tesseract, set the full path:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
# Max upload size in megabytes:
MAX_UPLOAD_MB=15

# ----- Intercom (fill when you connect the real Messenger) -----
# IMPORTANT: use the NEW rotated access token. The old token was exposed
# in chat on Sep 16 - rotate/revoke it in Intercom first, then paste the
# new one here. Never send tokens through WhatsApp or commit them.
INTERCOM_ACCESS_TOKEN=
INTERCOM_WEBHOOK_SECRET=
INTERCOM_API_BASE=https://api.intercom.io
INTERCOM_ADMIN_ID=
INTERCOM_TEAM_ID=

# ----- Moss (real retrieval in the hackathon build; stub works without it) -----
MOSS_API_KEY=
MOSS_INDEX_NAME=
